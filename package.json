{
  "name": "magnet-mayhem",
  "version": "0.1.0",
  "private": true,
  "description": "Magnet Mayhem: one-finger magnetic physics arcade game (Android app via Capacitor)",
  "scripts": {
    "test": "node scripts/smoke-test.js",
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/status-bar": "^8.0.4"
  }
}
